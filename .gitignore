*.log
.DS_Store
.env
# Runtime dirs written by Composer/PsySH/XDG tools when HOME=APP_DIR in the container.
# Never commit these; they dirty the working tree and bloat the repo.
/.cache/
/.config/
/.local/
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/build.incoming.*
/public/build.outgoing.*
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
/vendor.incoming.*
/vendor.outgoing.*
# Deploy runtime. nginx-upstream.conf is a tracked symlink; everything else is local.
/.deploy/*
!/.deploy/nginx-upstream.conf
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
