APP_NAME=Singlepage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.jadidaring.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Local: jadidaring.test / admin.jadidaring.test
# Production: jadidaring.com / admin.jadidaring.com
APP_BASE_DOMAIN=jadidaring.test
ADMIN_DOMAIN=admin.jadidaring.test

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared MySQL from ~/project/infrastructure (container: mysql-db)
DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=comprof_cms
DB_USERNAME=root
DB_PASSWORD=root

# Host-only admin cookie. Do NOT set SESSION_DOMAIN=.jadidaring.test
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=false

# One Reverb process for every game subdomain. Nginx proxies /app and /apps.
# REVERB_HOST is the Docker service name. Browsers use the tenant host, not this host.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Published on the host for global-proxy → 127.0.0.1:APP_PORT
APP_PORT=8081

# Laravel Boost (dev-only package). These must be set in production to prevent
# the browser-log watcher script from being injected into client pages.
# BoostServiceProvider::shouldRun() already gates on environment=local OR
# APP_DEBUG=true, so setting APP_ENV=production + APP_DEBUG=false is
# sufficient. BOOST_BROWSER_LOGS_WATCHER=false is an additional hard guard.
# Also run: composer install --no-dev && php artisan config:cache
#BOOST_BROWSER_LOGS_WATCHER=false

# Fallback GM key when Settings → Gamemaster secret is empty or unset.
# Preferred: seated players type this code and POST /api/game/rooms/{code}/gamemaster.
# Transitional/deprecated: GET /api/game/rooms?gm= or X-Game-Master still lists
# private rooms. Live clients still send a hardcoded key (gamemasterjd, rolling
# toward gmjd1212). Never expose this value on /api/game/config.
GAME_GAMEMASTER_SECRET=gamemasterjd

# Machine-to-machine admin API on the admin host (POST/PATCH /api/admin/clients).
# Send as header: X-Admin-Api-Key: <secret>
# This value is a local placeholder only. Set a unique production secret via env:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ADMIN_API_SECRET=8be086b79b3219017d12ab19fd02c8ab353b9ecdc58c4ea96e86033b893d39d6
