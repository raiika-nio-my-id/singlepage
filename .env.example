APP_NAME=Singlepage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.jadidaring.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Local: jadidaring.test / admin.jadidaring.test
# Production: jadidaring.com / admin.jadidaring.com
APP_BASE_DOMAIN=jadidaring.test
ADMIN_DOMAIN=admin.jadidaring.test

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared MySQL from ~/project/infrastructure (container: mysql-db)
DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=comprof_cms
DB_USERNAME=root
DB_PASSWORD=root

# Host-only admin cookie. Do NOT set SESSION_DOMAIN=.jadidaring.test
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Published on the host for global-proxy → 127.0.0.1:APP_PORT
APP_PORT=8081
