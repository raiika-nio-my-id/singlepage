server { listen 443 ssl http2; server_name *.jadidaring.com; root /var/www/singlepage/public; index index.php; location / { try_files $uri $uri/ /index.php?$query_string; } location ~ \.php$ { include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; fastcgi_pass unix:/run/php/php-fpm.sock; } location ~ /\. { deny all; } }
